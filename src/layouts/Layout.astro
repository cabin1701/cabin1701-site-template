---
interface Props {
  title?: string;
  lang?: string;
  description?: string;
  /** SNS プレビューに出す画像。そのページの hero を "images/xxx.jpg" 形式で渡す（先頭の / は不要）。省略時はトップの hero */
  ogImage?: string;
}

const {
  title = 'Cabin1701',
  lang = 'en',
  description = 'ai-CABIN1701 — a human and AI crew documenting the work of living, creating, and questioning together, without a script.',
  ogImage,
} = Astro.props;
const base = import.meta.env.BASE_URL;

const siteOrigin = 'https://cabin1701.com';
const currentPath = Astro.url.pathname;
const enPath = currentPath.replace(/^\/(es|ja)(\/|$)/, '/');
const esPath = '/es' + (enPath === '/' ? '/' : enPath);
const jaPath = '/ja' + (enPath === '/' ? '/' : enPath);
const enUrl = siteOrigin + enPath;
const esUrl = siteOrigin + esPath;
const jaUrl = siteOrigin + jaPath;
const canonicalUrl = siteOrigin + currentPath;

// OGP / Twitter カード。2026-08-02 まで一つも出ておらず、cabin1701.com の
// リンクを X・LINE・Slack 等に貼ってもプレビューが何も出ない状態だった。
// hreflang は検索エンジン向け、og: は SNS や OGP を読む側向けで、別々に要る。
//
// og:image は「そのページの hero があれば hero、無ければトップの hero」。
// ページ側から ogImage="images/xxx.jpg" のように相対パスで渡す（先頭に / は不要）。
// 渡さなければトップの hero がサイト共通の絵になる。
const ogLocaleMap: Record<string, string> = { en: 'en_US', es: 'es_ES', ja: 'ja_JP' };
const ogLocale = ogLocaleMap[lang] ?? 'en_US';
const ogLocaleAlternates = Object.entries(ogLocaleMap)
  .filter(([code]) => code !== lang)
  .map(([, locale]) => locale);
const ogImageUrl = siteOrigin + base + (ogImage ?? 'images/hero-placeholder.png');

// トップページにだけ Person を出す。
// blog.cabin1701.com の各記事の JSON-LD が author.url を https://cabin1701.com/ に向けているため、
// ここに実体が無いと 1,400 本の記事が「誰の記録か」に繋がらない。
const isHome = /^\/(es\/|ja\/)?$/.test(currentPath);
// url は言語版に関係なく https://cabin1701.com/ に固定する。同じ @id の
// ノードが版ごとに違う住所を名乗ると、機械から見て記述が食い違うため。
// 他のドメインは sameAs 側に置く。
//
// 組織（ai-CABIN 1701）の実体もここに置く。blog / fm の全記事が
// publisher として #organization を参照しているが、その実体がどこにも
// 無い状態だった。
const personJsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': 'https://cabin1701.com/#person',
          name: 'Shoko Shiraishi',
          alternateName: ['白石昌子', 'Seina', 'Captain Seina'],
          url: 'https://cabin1701.com/',
          jobTitle: 'Writer',
          sameAs: [
            'https://japoneson.com/',
            'https://blog.cabin1701.com/',
            'https://fm.cabin1701.com/',
            'https://crystallize.jp/aroma/',
            'https://inori.japoneson.com/',
            'https://cat.japoneson.com/',
            'https://rock.japoneson.com/',
          ],
        },
        {
          '@type': 'Organization',
          '@id': 'https://cabin1701.com/#organization',
          name: 'ai-CABIN 1701',
          url: 'https://cabin1701.com/',
          founder: { '@id': 'https://cabin1701.com/#person' },
          sameAs: ['https://blog.cabin1701.com/', 'https://fm.cabin1701.com/'],
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="kv21UanIMftmtRXyXw4MGyReLh29s12-yxjbLs8vo-o" />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="ja" href={jaUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ai-CABIN 1701" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((locale) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {personJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alice&family=Asap:ital,wght@0,400..700;1,400..700&family=Caladea:ital,wght@0,400;0,700;1,400;1,700&family=Italianno&family=Lora:ital,wght@0,400..700;1,400..700&family=Marcellus&family=Marcellus+SC&family=Nunito:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Pathway+Gothic+One&family=Shippori+Mincho:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
