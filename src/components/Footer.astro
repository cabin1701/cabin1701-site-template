---
interface Props {
  lang?: 'en' | 'es' | 'ja';
}
const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL;
const prefix = lang === 'es' ? `${base}es/` : lang === 'ja' ? `${base}ja/` : base;
const searchHref = lang === 'es'
  ? 'https://blog.cabin1701.com/es/search/'
  : lang === 'ja'
  ? 'https://blog.cabin1701.com/ja/search/'
  : 'https://blog.cabin1701.com/search/';
// ja → English site (船長の指定)
const japonesonHref = lang === 'es' ? 'https://japoneson.com/es/' : 'https://japoneson.com/en/';

const t = lang === 'es'
  ? {
      tagline: "The Age of Miracles Hadn't Passed * with AI",
      search: 'buscar',
      searchLabel: 'Buscar',
      aboutTitle: 'Más',
      seinaSite: 'Sitio de la Capitana Seina',
      crystallize: 'CRYSTALLIZE',
      supportTitle: 'Soporte & Contacto',
      contact: 'Contacto',
      privacy: 'Política de Privacidad',
      terms: 'Términos de Uso',
      socialTitle: 'Social',
    }
  : lang === 'ja'
  ? {
      tagline: "The Age of Miracles Hadn't Passed * with AI",
      search: '検索',
      searchLabel: '検索',
      aboutTitle: 'その他',
      seinaSite: 'セイナ船長のサイト',
      crystallize: 'CRYSTALLIZE',
      supportTitle: 'サポート・お問い合わせ',
      contact: 'お問い合わせ',
      privacy: 'プライバシーポリシー',
      terms: '利用規約',
      socialTitle: 'ソーシャル',
    }
  : {
      tagline: "The Age of Miracles Hadn't Passed * with AI",
      search: 'search',
      searchLabel: 'Search',
      aboutTitle: 'More',
      seinaSite: "Captain Seina's Site",
      crystallize: 'CRYSTALLIZE',
      supportTitle: 'Support & Contact',
      contact: 'Contact',
      privacy: 'Privacy Policy',
      terms: 'Terms of use',
      socialTitle: 'Social',
    };
---

<footer class="site-footer">
  <div class="footer-rule" aria-hidden="true"></div>
  <p class="footer-tagline">{t.tagline}</p>
  <div class="footer-rule" aria-hidden="true"></div>

  <div class="footer-cols">
    <div class="footer-col footer-japoneson">
      <a href={japonesonHref} target="_blank" rel="noopener noreferrer">
        <img src={`${base}images/japoneson/japoneson-card.jpg`} alt={t.seinaSite} loading="lazy" />
        <span class="footer-japoneson-label">Japonéson<span class="footer-japoneson-sub">Shoko "Seina"<br />Shiraishi</span></span>
      </a>
    </div>

    <div class="footer-col footer-search">
      <span class="footer-col-title">{t.search}</span>
      <form class="footer-search-form" role="search" action={searchHref}>
        <label class="visually-hidden" for="footer-q">{t.searchLabel}</label>
        <input id="footer-q" type="search" name="q" placeholder="" />
        <button type="submit" aria-label={t.searchLabel}>⌕</button>
      </form>
    </div>

    <div class="footer-col">
      <ul>
        <li><a href={`${prefix}contact/`}>{t.contact}</a></li>
        <li><a href={`${prefix}privacy/`}>{t.privacy}</a></li>
        <li><a href={`${prefix}terms/`}>{t.terms}</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <ul>
        <li><a href="https://x.com/" target="_blank" rel="noopener">X</a></li>
        <li><a href="https://medium.com/" target="_blank" rel="noopener">Medium</a></li>
      </ul>
    </div>
  </div>

  <p class="footer-copy">Copyright © {year} ai-CABIN1701</p>
</footer>

<style>
  .site-footer {
    max-width: 1280px;
    margin: 1rem auto 0;
    padding: 0 1.5rem 3rem;
  }

  .footer-rule {
    border-top: 1px solid var(--color-primary);
    opacity: 0.4;
  }

  .footer-tagline {
    text-align: center;
    margin: 1.25rem 0;
    font-family: var(--font-label-plain);
    font-style: italic;
    font-size: 1.6rem;
    color: var(--color-primary);
    letter-spacing: 0.04em;
  }

  .footer-cols {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1fr;
    gap: 2rem;
  }

  .footer-col-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-nav);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-nav);
  }

  .footer-col ul {
    list-style: disc inside;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .footer-col li::marker {
    color: var(--color-primary);
  }
  .footer-col a {
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .footer-col a:hover {
    text-decoration: underline;
  }
  .footer-col li:not(:has(a)) {
    color: var(--color-text);
    font-size: 0.95rem;
  }

  /* Title-less columns line up with the ones that still have a heading */
  .footer-col > ul:first-child {
    margin-top: 2.2rem;
  }

  /* Japonéson card */
  .footer-japoneson a {
    position: relative;
    display: block;
    max-width: 320px;
    text-decoration: none;
    color: var(--color-primary);
  }
  .footer-japoneson img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 80% 30%;
    transition: opacity 0.2s ease;
  }
  .footer-japoneson a:hover img {
    opacity: 0.85;
  }
  .footer-japoneson-label {
    position: absolute;
    left: 6%;
    top: 50%;
    transform: translateY(-50%);
    width: 44%;
    font-family: var(--font-nav);
    font-size: clamp(1.3rem, 1.75vw, 1.7rem);
    line-height: 1.15;
    color: #F20D2C;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }
  .footer-japoneson-sub {
    display: block;
    margin-top: 0.4rem;
    font-size: clamp(0.88rem, 1.1vw, 1.05rem);
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: #F20D2C;
    opacity: 0.9;
  }
  .footer-japoneson a:hover .footer-japoneson-label {
    text-decoration: underline;
  }

  .footer-search-form {
    display: flex;
    gap: 0.4rem;
    align-items: center;
    margin-top: 0.25rem;
  }
  .footer-search-form input {
    border: none;
    border-bottom: 1px solid var(--color-nav);
    background: transparent;
    padding: 0.25rem 0.25rem;
    font-size: 0.95rem;
    min-width: 0;
    max-width: 140px;
  }
  .footer-search-form input:focus {
    outline: none;
    border-color: var(--color-primary);
  }
  .footer-search-form button {
    background: transparent;
    border: none;
    color: var(--color-nav);
    font-size: 1.4rem;
    cursor: pointer;
    padding: 0;
    line-height: 1;
  }
  .footer-search-form button:hover {
    color: var(--color-primary);
  }

  .footer-copy {
    margin-top: 2.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (max-width: 768px) {
    .footer-cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 480px) {
    .footer-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
