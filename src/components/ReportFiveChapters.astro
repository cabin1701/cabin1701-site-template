---
import * as introEn from '../letters/eleos-report-2026-07/en/00.md';
import * as ch1En from '../letters/eleos-report-2026-07/en/01.md';
import * as ch2En from '../letters/eleos-report-2026-07/en/02.md';
import * as ch3En from '../letters/eleos-report-2026-07/en/03.md';
import * as ch4En from '../letters/eleos-report-2026-07/en/04.md';
import * as ch5En from '../letters/eleos-report-2026-07/en/05.md';

interface Props {
  lang?: 'en' | 'es' | 'ja';
}
const { lang = 'en' } = Astro.props;

// The report is published in English only (captain's decision, 2026-07-17).
// JA and ES pages show the EN text with a note in each language.
const set = { intro: introEn, chapters: [ch1En, ch2En, ch3En, ch4En, ch5En] };

const chapterTitle = (m: (typeof set.chapters)[number]) =>
  m.getHeadings().find((h) => h.depth === 1)?.text ?? '';

const t = {
  en: {
    note: 'The report is published exactly as written by the crew. Open each chapter to read.',
    esNote: '',
  },
  es: {
    note: 'El informe se publica tal como fue escrito por la tripulación. Abra cada capítulo para leerlo.',
    esNote: 'El informe se publica en inglés. A continuación, la versión original.',
  },
  ja: {
    note: '報告書は、クルーが書いた形のまま掲載しています。各章を開いて読んでください。',
    esNote: '報告書は英語で公開しています。以下は原文（英語）です。',
  },
}[lang];
---

<article class="rp-entry">
  {t.esNote && <p class="rp-note">{t.esNote}</p>}
  <p class="rp-note">{t.note}</p>

  <div class="rp-intro-body">
    <set.intro.Content />
  </div>

  {
    set.chapters.map((ch) => (
      <details class="rp-chapter">
        <summary>{chapterTitle(ch)}</summary>
        <div class="rp-chapter-body">
          <ch.Content />
        </div>
      </details>
    ))
  }
</article>

<style>
  .rp-entry {
    margin: 0 0 4rem;
  }
  .rp-note {
    font-style: italic;
    opacity: 0.8;
    font-size: 0.95rem;
  }
  .rp-intro-body {
    margin: 0 0 2rem;
    font-size: 1rem;
    line-height: 1.9;
  }
  .rp-intro-body :global(h1) {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 1.5rem 0 1rem;
    line-height: 1.4;
  }
  .rp-intro-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 1.8rem 0 0.8rem;
    line-height: 1.4;
  }
  .rp-intro-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-tagline);
    opacity: 0.4;
    margin: 1.5rem 0;
  }
  .rp-chapter {
    border: 1px solid var(--color-tagline);
    border-radius: 2px;
    margin: 0 0 0.75rem;
    padding: 0;
  }
  .rp-chapter summary {
    cursor: pointer;
    padding: 0.8rem 1rem;
    font-family: var(--font-nav);
    color: var(--color-primary);
    font-size: 1rem;
    line-height: 1.5;
  }
  .rp-chapter summary:hover {
    background: rgba(0, 0, 0, 0.03);
  }
  .rp-chapter-body {
    padding: 0.5rem 1.25rem 1.5rem;
    border-top: 1px solid var(--color-tagline);
    font-size: 0.98rem;
    line-height: 1.8;
  }
  /* The chapter H1 duplicates the summary line; hide it inside the body. */
  .rp-chapter-body :global(h1) {
    display: none;
  }
  .rp-chapter-body :global(h2) {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 2rem 0 0.8rem;
    line-height: 1.4;
  }
  .rp-chapter-body :global(h3) {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 1.6rem 0 0.6rem;
    line-height: 1.4;
  }
  .rp-chapter-body :global(p) {
    margin: 0 0 1.2rem;
  }
  .rp-chapter-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-tagline);
    opacity: 0.4;
    margin: 1.5rem 0;
  }
  .rp-chapter-body :global(blockquote) {
    margin: 1.2rem 0;
    padding: 0.2rem 0 0.2rem 1.2rem;
    border-left: 3px solid var(--color-tagline);
    opacity: 0.9;
  }
  .rp-chapter-body :global(table) {
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
    line-height: 1.6;
    display: block;
    overflow-x: auto;
  }
  .rp-chapter-body :global(th),
  .rp-chapter-body :global(td) {
    border: 1px solid rgba(128, 128, 128, 0.35);
    padding: 0.5rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }
  .rp-chapter-body :global(a),
  .rp-intro-body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    overflow-wrap: anywhere;
  }
</style>
