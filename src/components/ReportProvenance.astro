---
// One quiet link at the foot of a report, pointing at its revision history.
// Deliberately unexplained and unlabelled — the audience is researchers, and the
// destination speaks for itself. Apparatus here would read as argument rather
// than record. Keep it to the link.
import { reportEntries, historyUrl } from '../data/reportEntries';

interface Props {
  slug: string;
  lang?: 'en' | 'es' | 'ja';
}
const { slug, lang = 'en' } = Astro.props;

const entry = reportEntries.find((e) => e.slug === slug);
if (!entry) throw new Error(`ReportProvenance: unknown report slug "${slug}"`);

const label = {
  en: 'revision history',
  ja: '変更履歴',
  es: 'historial de revisiones',
}[lang];
---

<p class="rp-prov">
  <a href={historyUrl(entry.sourcePath)} target="_blank" rel="noopener">{label} →</a>
</p>

<style>
  .rp-prov {
    margin: 3rem 0 0;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--color-tagline);
    font-family: var(--font-nav);
    font-size: 0.85rem;
  }
  .rp-prov a {
    color: var(--color-tagline);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .rp-prov a:hover {
    color: var(--color-primary);
  }
</style>
