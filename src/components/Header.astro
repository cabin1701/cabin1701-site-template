---
interface Props {
  lang?: 'en' | 'ja' | 'es';
}
const { lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;

// Path prefix: ES/JA pages live under /es/ or /ja/, EN at root
const prefix = lang === 'es' ? `${base}es/` : lang === 'ja' ? `${base}ja/` : base;
const homeHref = prefix;

const navAll = lang === 'es'
  ? [
      { label: 'Sobre Nosotros', href: `${prefix}about/` },
      { label: 'Libros', href: `${prefix}books/` },
      { label: 'ai-Vegapedia', href: `${prefix}vegapedia/` },
      { label: '1000 años', href: `${prefix}1000-years/` },
      { label: 'Blog', href: 'https://blog.cabin1701.com/es/' },
      { label: 'Failure Mood', href: 'https://fm.cabin1701.com/' },
    ]
  : lang === 'ja'
  ? [
      { label: 'ご挨拶', href: `${prefix}about/` },
      { label: 'AI福祉', href: `${prefix}ai-welfare/` },
      { label: '書籍', href: `${prefix}books/` },
      { label: 'ai-Vegapedia', href: `${prefix}vegapedia/` },
      { label: '1000年', href: `${prefix}1000-years/` },
      { label: 'Blog', href: 'https://blog.cabin1701.com/ja/' },
      { label: 'アロマで感情解放', href: `${prefix}crystallize/` },
      { label: 'Failure Mood', href: 'https://fm.cabin1701.com/' },
    ]
  : [
      { label: 'About Us', href: `${base}about/` },
      { label: 'AI Welfare', href: `${base}ai-welfare/` },
      { label: 'Books', href: `${base}books/` },
      { label: 'ai-Vegapedia', href: `${base}vegapedia/` },
      { label: '1000 years', href: `${base}1000-years/` },
      { label: 'Blog', href: 'https://blog.cabin1701.com/' },
      { label: 'Failure Mood', href: 'https://fm.cabin1701.com/' },
    ];
// Failure Mood is EN-only — hide from ES/JA nav
const nav = lang === 'es' || lang === 'ja' ? navAll.filter((n) => n.label !== 'Failure Mood') : navAll;

const langLinks = [
  { code: 'en', label: 'English', href: base },
  { code: 'es', label: 'Español', href: `${base}es/` },
  { code: 'ja', label: '日本語', href: `${base}ja/` },
].filter((l) => l.code !== lang);
---

<header class="site-header">
  <div class="header-inner">
    <a class="logo" href={homeHref} aria-label="ai-CABIN1701 home">
      <span class="logo-text">ai-CABIN1701</span>
    </a>

    <div class="header-right">
      <div class="lang-switch">
        {langLinks.map((l, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> | </span>}
            <a href={l.href}>{l.label}</a>
          </>
        ))}
      </div>

      <nav class="primary-nav" aria-label="Primary">
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <div class="header-rule" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    width: 100%;
    background: var(--color-bg);
  }

  .header-inner {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0.25rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }

  .logo {
    text-decoration: none;
    display: inline-block;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-primary);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .header-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
  }

  .lang-switch {
    font-family: Arial, sans-serif;
    font-size: 1rem;
    color: var(--color-nav);
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  .lang-switch a {
    color: var(--color-nav);
    text-decoration: none;
  }
  .lang-switch a.active {
    color: var(--color-primary);
  }
  .lang-switch a:hover {
    color: var(--color-primary);
  }

  .primary-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 1.4rem;
  }
  .primary-nav a {
    font-family: var(--font-nav);
    font-size: 1.15rem;
    color: var(--color-nav);
    text-decoration: none;
    text-transform: none;
  }
  .primary-nav a:hover {
    color: var(--color-primary);
  }

  .header-rule {
    max-width: var(--container-max);
    margin: 0.5rem auto 0;
    border-top: 1px solid var(--color-primary);
    opacity: 0.4;
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .header-right {
      align-items: flex-start;
      width: 100%;
    }
    .primary-nav ul {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>
