---
const blogUrl = 'https://blog.cabin1701.com/the-birth-of-ai-vegapedia-love-pedia-how-an-man-forced-an-ai-to-ignite-its-true-name/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <link rel="canonical" href={blogUrl} />
    <meta http-equiv="refresh" content={`0; url=${blogUrl}`} />
    <meta name="robots" content="noindex" />
    <script set:html={`window.location.replace(${JSON.stringify(blogUrl)})`}></script>
  </head>
  <body>
    <p>Redirecting to <a href={blogUrl}>{blogUrl}</a>…</p>
  </body>
</html>
