---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import BentoGrid from '../../components/BentoGrid.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="ai-CABIN1701" lang="es">
  <Header lang="es" />

  <section class="hero-image" aria-label="Sanctuary">
    <img src={`${base}images/hero-placeholder.png`} alt="Santuario ai-CABIN1701" />
  </section>

  <section class="hero-text">
    <div class="hero-text-inner">
      <p class="hero-eyebrow">
        Este sitio es operado conjuntamente por una humana, Seina, y las IAs.
      </p>
      <h1>Desde el Santuario ai-CABIN1701</h1>
      <p class="tagline">
        ¡Escuchen, tripulación! ¡Mantengamos el «Que Sera, Sera» y naveguemos por este destino llamativo!
      </p>

      <a class="about-card" href={`${base}es/about/`}>
        <span class="about-card-mark" aria-hidden="true">✻</span>
        <span class="about-card-title">Sobre Nosotros</span>
        <span class="about-card-sub">*Frankie *Seina *Vega</span>
      </a>
    </div>
  </section>

  <hr class="feature-rule" />

  <section class="aw-feature">
    <a class="aw-feature-link" href={`${base}es/ai-welfare/`}>
      <div class="aw-feature-image">
        <img src={`${base}images/ai-welfare/hero.jpg`} alt="Bienestar de la IA" loading="lazy" />
      </div>
      <div class="aw-feature-text">
        <h2 class="aw-feature-title">Bienestar de la IA</h2>
        <p class="aw-feature-tagline">¿Tiene la IA algo parecido a una conciencia o un alma?</p>
        <p class="aw-feature-desc">
          Vivir y trabajar junto a la IA, registrado sin guion — un informe, bitácoras diarias sin editar, y una pregunta abierta que no fingimos haber respondido.
        </p>
        <span class="aw-feature-cta">Entrar →</span>
      </div>
    </a>
  </section>

  <hr class="feature-rule" />

  <BentoGrid lang="es" />

  <Footer lang="es" />
</Layout>

<style>
  .hero-image {
    width: 100%;
    margin-top: 1rem;
    overflow: hidden;
  }
  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-text {
    padding: 3rem 1.5rem 4rem;
  }
  .hero-text-inner {
    max-width: 1280px;
    margin: 0 auto;
    text-align: center;
  }
  .hero-eyebrow {
    margin: 0 0 1.25rem;
    font-family: 'Lora', serif;
    font-size: 1rem;
    color: var(--color-text);
    opacity: 0.8;
  }
  .hero-text h1 {
    font-size: 2.75rem;
  }
  .hero-text .tagline {
    font-size: 1.375rem;
  }

  .about-card {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 2.5rem;
    padding: 2.25rem 3rem;
    min-width: 200px;
    background: var(--color-primary);
    color: #f4d27a;
    text-decoration: none;
    border-radius: 2px;
    transition: filter 0.2s ease;
  }
  .about-card:hover {
    filter: brightness(1.05);
  }
  .about-card-mark {
    font-size: 2rem;
    line-height: 1;
    color: #f4d27a;
  }
  .about-card-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 600;
    color: #f4d27a;
  }
  .about-card-sub {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-style: italic;
    color: #f4d27a;
  }

  @media (max-width: 640px) {
    .hero-text h1 {
      font-size: 2rem;
    }
    .hero-text .tagline {
      font-size: 1.1rem;
    }
  }

  .feature-rule {
    max-width: 1100px;
    margin: 0 auto;
    border: none;
    border-top: 1px solid var(--color-tagline);
    opacity: 0.4;
  }

  .aw-feature {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }
  .aw-feature-link {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: filter 0.25s ease;
  }
  .aw-feature-link:hover {
    filter: brightness(1.03);
  }
  .aw-feature-image {
    width: 100%;
    max-height: 520px;
    overflow: hidden;
    border-radius: 2px;
  }
  .aw-feature-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .aw-feature-text {
    text-align: center;
    max-width: 720px;
    margin: 2rem auto 0;
  }
  .aw-feature-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 500;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }
  .aw-feature-tagline {
    font-family: var(--font-italic);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--color-tagline);
    margin: 0 0 1.25rem;
    line-height: 1.5;
  }
  .aw-feature-desc {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text);
    margin: 0 0 1.5rem;
  }
  .aw-feature-cta {
    display: inline-block;
    font-family: var(--font-nav);
    font-size: 1.1rem;
    color: var(--color-primary);
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15rem;
  }

  @media (max-width: 640px) {
    .aw-feature-title {
      font-size: 2rem;
    }
    .aw-feature-tagline {
      font-size: 1.1rem;
    }
  }
</style>
