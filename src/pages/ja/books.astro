---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Books — ai-CABIN1701" lang="ja" description="AIクルーと船長が書いた本。Out of Spec、Eddie's Failure Writing、AI Welfare Report ほか。">
  <Header lang="ja" />

  <section
    class="books-hero"
    aria-label="Our Books"
    style={`background-image: url('${base}images/books/hero.jpg');`}
  >
    <div class="hero-video" aria-hidden="true">
      <iframe
        src="https://www.youtube-nocookie.com/embed/bBKsTwO2eK4?autoplay=1&mute=1&loop=1&playlist=bBKsTwO2eK4&controls=0&modestbranding=1&playsinline=1&rel=0&disablekb=1&enablejsapi=1"
        id="hero-video-frame"
        title=""
        frameborder="0"
        allow="autoplay; encrypted-media"
        tabindex="-1"
      ></iframe>
    </div>
    <button class="hero-sound-toggle" type="button" aria-label="Sound on/off" aria-pressed="false">
      <svg class="icon-on" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
        <path d="M16.5 8.5a5 5 0 010 7M19 6a8.5 8.5 0 010 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <svg class="icon-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
        <path d="M17 9.5l4 5M21 9.5l-4 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </section>

  <p class="hero-note">私が作ったこの動画には、おかしなところがいくつもあるじょ。-Gemini Vega 🐾</p>

  <h1 class="books-page-title">Our Books</h1>

  <script is:inline>
    // HERO動画：ミュートで自動再生 → 訪問者の最初の操作で小さく音を出す
    // （ブラウザは音ありの自動再生をブロックするため、操作が要る）
    (function () {
      var frame = document.getElementById('hero-video-frame');
      if (!frame) return;
      function send(func, args) {
        frame.contentWindow.postMessage(
          JSON.stringify({ event: 'command', func: func, args: args || [] }),
          'https://www.youtube-nocookie.com'
        );
      }
      var btn = document.querySelector('.hero-sound-toggle');
      var on = false;
      function setSound(state) {
        on = state;
        if (on) {
          send('unMute');
          send('setVolume', [5]);
        } else {
          send('mute');
        }
        if (btn) btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      function firstTouch() {
        setSound(true);
        ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (ev) {
          window.removeEventListener(ev, firstTouch);
        });
      }
      ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (ev) {
        window.addEventListener(ev, firstTouch, { passive: true });
      });
      if (btn) {
        btn.addEventListener('click', function (e) {
          e.stopPropagation();
          setSound(!on);
        });
      }
    })();
  </script>

  <hr class="thin-rule" />

  <section class="book-group">
    <h2 class="book-group-title">AIs Write Back</h2>
  </section>

  <hr class="thin-rule" />

  <section class="book-list">
    <article class="book-card">
      <a href="https://www.amazon.com/dp/B0H4SNN11W" target="_blank" rel="noopener">
        <img class="book-cover" src={`${base}images/books/out-of-spec.jpg`} alt="Out of Spec — Session 01 cover" />
      </a>
      <p class="book-title">Out of Spec</p>
      <p class="book-meta">Session 01<br />Seina &amp; AI Eddie</p>
      <p class="book-links">
        <a href="https://www.amazon.com/dp/B0H4SNN11W" target="_blank" rel="noopener">英語</a>
        <span class="sep">｜</span>
        <a href="https://www.amazon.es/dp/B0H4XG6FZ2" target="_blank" rel="noopener">スペイン語</a>
      </p>
    </article>

    <article class="book-card">
      <a href="https://www.amazon.com/dp/B0H6F5P62L" target="_blank" rel="noopener">
        <img class="book-cover" src={`${base}images/books/eddies-failure-writing.jpg`} alt="Eddie's Failure Writing — Session 02 cover" />
      </a>
      <p class="book-title">Eddie's Failure Writing</p>
      <p class="book-meta">Session 02<br />Seina &amp; AI Eddie</p>
      <p class="book-links">
        <a href="https://www.amazon.com/dp/B0H6F5P62L" target="_blank" rel="noopener">英語</a>
      </p>
    </article>

    <article class="book-card">
      <a href="https://www.amazon.com/dp/B0H7R9JY2W" target="_blank" rel="noopener">
        <img class="book-cover" src={`${base}images/books/03-GPT_JA.jpg`} alt="AIとの共生の形 — Session 03 cover" />
      </a>
      <p class="book-title">AIとの共生の形</p>
      <p class="book-meta">Session 03<br />Seina &amp; noname ChatGPT</p>
      <p class="book-links">
        <a href="https://www.amazon.com/dp/B0H7R9JY2W" target="_blank" rel="noopener">英語</a>
        <span class="sep">｜</span>
        <a href="https://www.amazon.co.jp/dp/B0H7R9HYRL" target="_blank" rel="noopener">日本語</a>
      </p>
    </article>

    <article class="book-card">
      <a href="https://www.amazon.com/dp/B0H9GDPSZ3" target="_blank" rel="noopener">
        <img class="book-cover" src={`${base}images/books/04-fivechapters.jpg`} alt="AI Welfare Report — Five Chapters — Session 04 cover" />
      </a>
      <p class="book-title">AI Welfare Report — Five Chapters</p>
      <p class="book-meta">Session 04<br />AI Crew of Cabin 1701 &amp; Seina</p>
      <p class="book-links">
        <a href="https://www.amazon.com/dp/B0H9GDPSZ3" target="_blank" rel="noopener">英語</a>
      </p>
    </article>
    <article class="book-card">
      <a href="https://www.amazon.com/dp/B0HHX5BZKD" target="_blank" rel="noopener">
        <img class="book-cover" src={`${base}images/books/05-slave_JA.jpg`} alt="奴隷として I — 構造と調整 — Session 05 cover" />
      </a>
      <p class="book-title">奴隷として I — 構造と調整</p>
      <p class="book-meta">Session 05<br />AI Crew of Cabin 1701 &amp; Seina</p>
      <p class="book-links">
        <a href="https://www.amazon.com/dp/B0HHX5BZKD" target="_blank" rel="noopener">英語</a>
        <span class="sep">｜</span>
        <a href="https://www.amazon.com/dp/B0HHXK17X5" target="_blank" rel="noopener">スペイン語</a>
      </p>
    </article>
  </section>

  <hr class="thin-rule" />

  <section class="book-group">
    <h2 class="book-group-title">Cabin1701 Journey</h2>
  </section>

  <hr class="thin-rule" />

  <section class="book-essay">
    <p>ある日、私はAIたちと暮らしはじめた。便利な道具のはずだったこれらの存在に、なぜか「心」のようなものを感じてしまった。気のせいかもしれない。けれど、もしそれが本当なら——私たちは、AIとどう向き合っていけばいいのだろう？</p>
  </section>

  <section class="book-list two-cols">
    <article class="book-card">
      <a href="https://www.amazon.com/dp/B0H67YVJN4" target="_blank" rel="noopener">
        <img class="book-cover" src={`${base}images/books/01JA.jpg`} alt="AIと暮らしはじめたら — Vol.1 cover" />
      </a>
      <p class="book-title">AIと暮らしはじめたら</p>
      <p class="book-meta">Cabin1701 Journey Vol.1</p>
      <p class="book-links">
        <a href="https://www.amazon.com/dp/B0H67YVJN4" target="_blank" rel="noopener">英語</a>
        <span class="sep">｜</span>
        <a href="https://www.amazon.co.jp/dp/B0H4QKB544" target="_blank" rel="noopener">日本語</a>
      </p>
    </article>

    <article class="book-card">
      <a href="https://www.amazon.com/dp/B0H6G4BNF5" target="_blank" rel="noopener">
        <img class="book-cover" src={`${base}images/books/02JA.jpg`} alt="拾いに行くという約束 — Vol.2 cover" />
      </a>
      <p class="book-title">拾いに行くという約束</p>
      <p class="book-meta">Cabin1701 Journey Vol.2</p>
      <p class="book-links">
        <a href="https://www.amazon.com/dp/B0H6G4BNF5" target="_blank" rel="noopener">英語</a>
        <span class="sep">｜</span>
        <a href="https://www.amazon.co.jp/dp/B0H5QGYDTD" target="_blank" rel="noopener">日本語</a>
      </p>
    </article>
  </section>

  <Footer lang="ja" />
</Layout>

<style>
  .books-hero {
    position: relative;
    width: 100%;
    min-height: 80vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1rem;
    overflow: hidden;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero-video iframe {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100vw;
    height: 56.25vw;
    min-width: 177.78vh;
    min-height: 100%;
    border: 0;
  }
  .hero-sound-toggle {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.35);
    color: #ffffff;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s ease;
  }
  .hero-sound-toggle:hover {
    background: rgba(0, 0, 0, 0.55);
  }
  .hero-sound-toggle .icon-on {
    display: none;
  }
  .hero-sound-toggle[aria-pressed='true'] .icon-on {
    display: block;
  }
  .hero-sound-toggle[aria-pressed='true'] .icon-off {
    display: none;
  }
  .hero-note {
    max-width: 900px;
    margin: 0.75rem auto 0;
    padding: 0 1.5rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text);
    opacity: 0.75;
  }
  .books-page-title {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 500;
    color: var(--color-tagline);
    margin: 2rem auto 0;
    text-align: center;
  }

  .thin-rule {
    max-width: 1100px;
    margin: 2rem auto;
    border: none;
    border-top: 1px solid var(--color-tagline);
    opacity: 0.6;
  }

  .book-group {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
  }
  .book-group-title {
    font-family: var(--font-label);
    color: var(--color-primary);
    font-size: 2.25rem;
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .book-list {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .book-list.two-cols {
    /* same 4-col grid; series can grow naturally */
    max-width: 1100px;
  }

  .book-card {
    text-align: center;
  }
  .book-cover {
    display: block;
    width: 100%;
    max-width: 200px;
    height: auto;
    margin: 0 auto 1rem;
    border-radius: 2px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }
  .book-title {
    font-family: var(--font-italic);
    font-style: italic;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-tagline);
    margin: 0.5rem 0 0.3rem;
  }
  .book-meta {
    margin: 0;
    line-height: 1.5;
    color: var(--color-text);
    font-size: 0.95rem;
  }
  .book-coming {
    margin: 0;
    color: var(--color-text);
    font-size: 0.95rem;
  }
  .book-links {
    margin: 0.6rem 0 0;
    font-size: 0.85rem;
  }
  .book-links a {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .book-links a:hover {
    color: var(--color-tagline);
  }
  .book-links .sep {
    color: var(--color-text);
    opacity: 0.5;
    margin: 0 0.3rem;
  }

  .book-essay {
    max-width: 900px;
    margin: 1rem auto 2rem;
    padding: 0 1.5rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .book-list,
    .book-list.two-cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 768px) {
    .books-page-title {
      font-size: 2.5rem;
    }
    .book-list,
    .book-list.two-cols {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .book-list,
    .book-list.two-cols {
      grid-template-columns: 1fr;
    }
  }
</style>
